# ==============================================================================
# CONFIGURAÇÃO DE CHAVES DAS 10 LLMs SELECIONADAS (TOTALMENTE GRATUITAS)
# ==============================================================================

# 1. Groq - Obtenha em: https://groq.com
GROQ_API_KEY="cole_sua_chave_groq_aqui"

# 2. Google Gemini - Obtenha em: https://google.com
GEMINI_API_KEY="cole_sua_chave_gemini_aqui"

# 3. Cerebras - Obtenha em: https://cerebras.ai
CEREBRAS_API_KEY="cole_sua_chave_cerebras_aqui"

# 4. OpenRouter - Obtenha em: https://openrouter.ai
OPENROUTER_API_KEY="cole_sua_chave_openrouter_aqui"

# 5. SiliconFlow - Obtenha em: https://siliconflow.cn
SILICONFLOW_API_KEY="cole_sua_chave_siliconflow_aqui"

# 6. NVIDIA NIM - Obtenha em: https://nvidia.com
NVIDIA_API_KEY="cole_sua_chave_nvidia_aqui"

# 7. Mistral AI / Codestral - Obtenha em: https://mistral.ai
MISTRAL_API_KEY="cole_sua_chave_mistral_aqui"

# 8. Cloudflare Workers AI - Obtenha em seu painel Cloudflare
CLOUDFLARE_API_KEY="cole_seu_token_de_api_cloudflare"
CLOUDFLARE_ACCOUNT_ID="cole_o_id_da_sua_conta_cloudflare"

# 9. Pollinations.ai (Não precisa de chave nem cadastro!)
# Deixe em branco, o script faz a requisição direto pela URL de forma anônima.

# 10. Kilo Code / LLM7 - Obtenha em: https://llm7.net (se exigir cadastro recente)
# Caso não precise de token no momento do teste, o código usará "free-key" automaticamente.
LLM7_API_KEY="free-key"
